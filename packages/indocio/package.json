{
  "name": "@igrislabs/indocio",
  "version": "0.0.1",
  "description": "A Nuxt Content documentation layer built with IPEX and Akaza UI.",
  "keywords": [
    "akaza-ui",
    "documentation",
    "ipex",
    "nuxt",
    "nuxt-content",
    "nuxt-layer"
  ],
  "files": [
    "app",
    "modules",
    "public",
    "nuxt.config.ts",
    "content.config.ts"
  ],
  "type": "module",
  "main": "./nuxt.config.ts",
  "exports": {
    ".": "./nuxt.config.ts",
    "./content": "./content.config.ts",
    "./types": "./app/utils/docs-config.ts",
    "./ui-config": "./app/components/ui/ui.config.ts"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "dev:prepare": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "test": "node --test tests/*.test.ts",
    "test:integration": "node tests/integration.mjs"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.152",
    "@iconify-json/tabler": "^1.2.43",
    "@nuxt/content": "3.16.2",
    "@nuxt/fonts": "1.2.0",
    "@nuxt/hints": "1.1.5",
    "@nuxt/icon": "2.6.2",
    "@nuxt/image": "2.2.1",
    "@nuxt/kit": "^4.6.4",
    "@nuxtjs/color-mode": "4.1.0",
    "@nuxtjs/i18n": "10.6.0",
    "@nuxtjs/seo": "6.0.1",
    "@speed-highlight/core": "^2.1.0",
    "@tailwindcss/vite": "^4.3.5",
    "@vueuse/nuxt": "^15.0.0",
    "akaza-ui": "0.0.10-alpha",
    "better-sqlite3": "^13.0.3",
    "cn": "^0.5.2",
    "nuxt": "^4.6.4",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.5",
    "vue": "^3.5.45",
    "vue-router": "^5.4.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.3.14"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
